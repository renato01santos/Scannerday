{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/scanner", "destination": "/index.html" },
    { "source": "/picks", "destination": "/index.html" },
    { "source": "/results", "destination": "/index.html" },
    { "source": "/analytics", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/import-scanner", "destination": "/index.html" },
    { "source": "/admin/import-picks", "destination": "/index.html" },
    { "source": "/admin/import-results", "destination": "/index.html" },
    { "source": "/admin/users", "destination": "/index.html" },
    { "source": "/admin/settings", "destination": "/index.html" },
    { "source": "/admin/import-history", "destination": "/index.html" },
    { "source": "/admin/scanner-history", "destination": "/index.html" },
    { "source": "/admin/scanner-performance", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
